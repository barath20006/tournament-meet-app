# ========================================================
# SportMeet Environment Configuration Template
# ========================================================

# Server Port
SERVER_PORT=8080

# Active Spring Profile (default 'dev' with embedded H2/PostgreSQL mode, or 'postgres')
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Configuration (when using 'postgres' profile)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sportmeet_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Secret Key (HMAC-SHA256, 256-bit)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Android Localhost Alias (10.0.2.2 for Android Studio Emulator, or machine IP for physical devices)
ANDROID_API_BASE_URL=http://10.0.2.2:8080/
